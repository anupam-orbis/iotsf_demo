\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Layer-wise unfreeze profile (ETTh2 $n{=}10$k, $h{=}96$; mean$\pm $std over seeds). $N$ = number of top transformer layers left trainable (Moirai-Small has 6). \textbf  {The rows do not all come from one environment, and the seed counts differ.} $N{=}3$ and $N{=}6$ are the re-run 10-seed, early-stopped MPS set (42/101/123/202/303/456/777/789/888/999; \texttt  {results/v49\_layerunfreeze\_10seed}). $N{=}4$ and $N{=}5$ are a pre-registered top-up in the \emph  {same} root, protocol and environment, but at \textbf  {3 seeds}, so they are comparable to the pair in kind and much less precise than it. $N{=}0$ is 5 seeds (42/101/123/202/456; \texttt  {v18\_cond\_d\_probe}) and $N{=}1$ one, both \emph  {without} early stopping, so they read the final epoch rather than the best one. Only $N{=}3$ versus $N{=}6$ is matched at equal seed counts. Dispersion is population std ($\mathrm  {ddof}{=}0$) on the two topped-up rows, which is what their registration fixed, and sample std ($\mathrm  {ddof}{=}1$) on the rows that predate it: the registration also asserted that this column already used $\mathrm  {ddof}{=}0$, which was wrong, so rather than restate a registered choice after the fact we keep it and report the column as mixed, with the footnote giving the topped-up rows both ways. Ridge $\Delta R^2$ is the \textbf  {withdrawn} probe quantity (\S  \ref {sec:retraction}), reported here only as a record, and is not recomputed for any claim.}}{40}{table.caption.35}\protected@file@percent }
\newlabel{tab:layerunfreeze}{{22}{40}{Layer-wise unfreeze profile (ETTh2 $n{=}10$k, $h{=}96$; mean$\pm $std over seeds). $N$ = number of top transformer layers left trainable (Moirai-Small has 6). \textbf {The rows do not all come from one environment, and the seed counts differ.} $N{=}3$ and $N{=}6$ are the re-run 10-seed, early-stopped MPS set (42/101/123/202/303/456/777/789/888/999; \texttt {results/v49\_layerunfreeze\_10seed}). $N{=}4$ and $N{=}5$ are a pre-registered top-up in the \emph {same} root, protocol and environment, but at \textbf {3 seeds}, so they are comparable to the pair in kind and much less precise than it. $N{=}0$ is 5 seeds (42/101/123/202/456; \texttt {v18\_cond\_d\_probe}) and $N{=}1$ one, both \emph {without} early stopping, so they read the final epoch rather than the best one. Only $N{=}3$ versus $N{=}6$ is matched at equal seed counts. Dispersion is population std ($\mathrm {ddof}{=}0$) on the two topped-up rows, which is what their registration fixed, and sample std ($\mathrm {ddof}{=}1$) on the rows that predate it: the registration also asserted that this column already used $\mathrm {ddof}{=}0$, which was wrong, so rather than restate a registered choice after the fact we keep it and report the column as mixed, with the footnote giving the topped-up rows both ways. Ridge $\Delta R^2$ is the \textbf {withdrawn} probe quantity (\S \ref {sec:retraction}), reported here only as a record, and is not recomputed for any claim}{table.caption.35}{}}
