\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Baseline-relative pre-trained advantage $V_{\text  {ridge}} {=} 1 {-} \text  {MSE}_{\text  {ZS}}/\text  {MSE}_{\text  {Linear}}$ for every Moirai cell, on both splits. The \emph  {selection} columns are the paper's primary gate: they are disjoint from the held-out windows every intervention outcome is scored on, so cell inclusion is not a judgement made after seeing the outcome. The \emph  {held-out} columns are the retrospective variant, reported as a sensitivity analysis. Bold marks a pass on the \emph  {primary} split in both columns of that row, so the bold set is the one the body's counts refer to. \textbf  {Not a linear probe}: this is a ratio of forecast MSEs computed through Moirai's own forecasting head, and shares no machinery with a linear-probe $\Delta R^2$ axis. \textbf  {Estimator, exactly}: $\text  {MSE}_{\text  {ZS}}$ is the median of 20 Moirai forecast samples at extended lookback (context $+$ horizon); $\text  {MSE}_{\text  {Linear}}$ is a single lookback-96 ridge-OLS linear map $\mathbb  {R}^{96 \times D} {\to } \mathbb  {R}^{h \times D}$ \emph  {fit on the cell's training windows} and applied unchanged out of sample; both are computed on the same matched windows within a split (300 selection, 300 held-out), train-normalised. The gate involves no fine-tuning, so a cell has one value at every $n$: the $n{=}500$ and $n{=}10$k (ES) operating points reported in \S  \ref {sec:forecasting} share the entry shown here. Bold ${=}$ gate-pass at the $0.20$ threshold on the primary split. ``---'' ${=}$ not run.}}{19}{table.caption.12}\protected@file@percent }
\newlabel{tab:r2task}{{5}{19}{Baseline-relative pre-trained advantage $\Vb {\text {ridge}} {=} 1 {-} \text {MSE}_{\text {ZS}}/\text {MSE}_{\text {Linear}}$ for every Moirai cell, on both splits. The \emph {selection} columns are the paper's primary gate: they are disjoint from the held-out windows every intervention outcome is scored on, so cell inclusion is not a judgement made after seeing the outcome. The \emph {held-out} columns are the retrospective variant, reported as a sensitivity analysis. Bold marks a pass on the \emph {primary} split in both columns of that row, so the bold set is the one the body's counts refer to. \textbf {Not a linear probe}: this is a ratio of forecast MSEs computed through Moirai's own forecasting head, and shares no machinery with a linear-probe $\Delta R^2$ axis. \textbf {Estimator, exactly}: $\text {MSE}_{\text {ZS}}$ is the median of 20 Moirai forecast samples at extended lookback (context $+$ horizon); $\text {MSE}_{\text {Linear}}$ is a single lookback-96 ridge-OLS linear map $\mathbb {R}^{96 \times D} {\to } \mathbb {R}^{h \times D}$ \emph {fit on the cell's training windows} and applied unchanged out of sample; both are computed on the same matched windows within a split (300 selection, 300 held-out), train-normalised. The gate involves no fine-tuning, so a cell has one value at every $n$: the $n{=}500$ and $n{=}10$k (ES) operating points reported in \S \ref {sec:forecasting} share the entry shown here. Bold ${=}$ gate-pass at the $0.20$ threshold on the primary split. ``---'' ${=}$ not run}{table.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A7}The Strict-Freeze Control}{19}{appendix.G}\protected@file@percent }
\newlabel{app:strictfreeze}{{A7}{19}{The Strict-Freeze Control}{appendix.G}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Sample-size sweep on Moirai-Small/ETTh2} ($h{=}96$, condition~B). On held-out windows drift grows (CKA$\downarrow $ as $n\uparrow $) while forgetting \emph  {falls}: more data moves the encoder further and leaves the model further ahead of zero-shot ($10/10$ seeds negative at $n{=}10{,}000$, Wilson CI $[0.72, 1.00]$). \textbf  {If drift magnitude predicted harm the two columns would rise together; they move in opposite directions.} Scored on the selection windows instead (\emph  {sel.}), forgetting is non-monotonic in $n$, the selection-split effect of \S  \ref {sec:analysis:heldout}. Dispersion here is the sample standard deviation over seeds ($\text  {ddof}{=}1$), not the standard error the rest of the paper reports, because the table is about how the spread across seeds moves with $n$.}}{20}{table.caption.13}\protected@file@percent }
\newlabel{tab:sample_sweep}{{6}{20}{\textbf {Sample-size sweep on Moirai-Small/ETTh2} ($h{=}96$, condition~B). On held-out windows drift grows (CKA$\downarrow $ as $n\uparrow $) while forgetting \emph {falls}: more data moves the encoder further and leaves the model further ahead of zero-shot ($10/10$ seeds negative at $n{=}10{,}000$, Wilson CI $[0.72, 1.00]$). \textbf {If drift magnitude predicted harm the two columns would rise together; they move in opposite directions.} Scored on the selection windows instead (\emph {sel.}), forgetting is non-monotonic in $n$, the selection-split effect of \S \ref {sec:analysis:heldout}. Dispersion here is the sample standard deviation over seeds ($\text {ddof}{=}1$), not the standard error the rest of the paper reports, because the table is about how the spread across seeds moves with $n$}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Sample-size sweep on Moirai-Small/ETTh2 (full fine-tuning, $h{=}96$), read from the same records as Table~\ref {tab:sample_sweep}; error bars are standard errors over seeds. (a)~CKA against the pre-trained encoder falls as $n$ grows. (b)~Held-out forgetting falls with it, so more drift goes with a better outcome; scored on the selection windows instead, forgetting is non-monotonic. Hollow markers at $n{=}10$k are the early-stopped arm.}}{20}{figure.caption.21}\protected@file@percent }
\newlabel{fig:dissociation}{{3}{20}{Sample-size sweep on Moirai-Small/ETTh2 (full fine-tuning, $h{=}96$), read from the same records as Table~\ref {tab:sample_sweep}; error bars are standard errors over seeds. (a)~CKA against the pre-trained encoder falls as $n$ grows. (b)~Held-out forgetting falls with it, so more drift goes with a better outcome; scored on the selection windows instead, forgetting is non-monotonic. Hollow markers at $n{=}10$k are the early-stopped arm}{figure.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces All 31 intervention cells (the 31 of 32 screened cells with a paired B/D run): \textbf  {selection-split} gate $V_{\text  {ridge}}$ (the primary gate of \S  \ref {sec:forecasting:gate}, scored on windows disjoint from the outcome columns beside it), then B$-$D on validation and on held-out windows (positive ${=}$ the frozen encoder was better), and whether the validation and held-out readings disagree in sign. Every row names its own $n$ because $n$ is \emph  {not} constant down the column: the ETTh2 spectrum cells ran at 500 while their same-dataset neighbours ran at 1{,}000, and a row that stayed silent would read as sharing its neighbour's. ILI is the one cell with no cap: it trains on its whole 452-window split, since it is the only series small enough, so its $n$ is a size rather than a subsample. Generated by \texttt  {scripts/cell\_matrix.py --latex}.}}{21}{table.caption.15}\protected@file@percent }
\newlabel{tab:heldout_all}{{7}{21}{All 31 intervention cells (the 31 of 32 screened cells with a paired B/D run): \textbf {selection-split} gate $\Vb {\text {ridge}}$ (the primary gate of \S \ref {sec:forecasting:gate}, scored on windows disjoint from the outcome columns beside it), then B$-$D on validation and on held-out windows (positive ${=}$ the frozen encoder was better), and whether the validation and held-out readings disagree in sign. Every row names its own $n$ because $n$ is \emph {not} constant down the column: the ETTh2 spectrum cells ran at 500 while their same-dataset neighbours ran at 1{,}000, and a row that stayed silent would read as sharing its neighbour's. ILI is the one cell with no cap: it trains on its whole 452-window split, since it is the only series small enough, so its $n$ is a size rather than a subsample. Generated by \texttt {scripts/cell\_matrix.py --latex}}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {The four sign reversals between selection and held-out windows} (\S  \ref {sec:analysis:heldout}). $\Delta $ adapted and $\Delta $ frozen are the change in each arm's forgetting when scoring moves from the selection split to the held-out split; $\text  {zs}_\text  {test}/\text  {zs}_\text  {val}$ is the untrained checkpoint's error ratio between the two splits, an exchangeability check that involves no fine-tuning. All four reversals run from ``frozen better'' to ``adapted better''. $n$ is per row and not constant (Table~\ref {tab:heldout_all}), and is taken from the published row rather than re-read here. Generated by \texttt  {scripts/heldout\_decomposition.py}.}}{22}{table.caption.16}\protected@file@percent }
\newlabel{tab:heldout_decomp}{{8}{22}{\textbf {The four sign reversals between selection and held-out windows} (\S \ref {sec:analysis:heldout}). $\Delta $ adapted and $\Delta $ frozen are the change in each arm's forgetting when scoring moves from the selection split to the held-out split; $\text {zs}_\text {test}/\text {zs}_\text {val}$ is the untrained checkpoint's error ratio between the two splits, an exchangeability check that involves no fine-tuning. All four reversals run from ``frozen better'' to ``adapted better''. $n$ is per row and not constant (Table~\ref {tab:heldout_all}), and is taken from the published row rather than re-read here. Generated by \texttt {scripts/heldout\_decomposition.py}}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {Cross-backbone results ($h{=}24$)} (\S  \ref {sec:forecasting:nonmoirai}). Every non-Moirai cell with a paired frozen-encoder run: \textbf  {selection-split} gate $V_{\text  {ridge}}$ (\textsuperscript  {f}${=}$gate-fail at the $0.20$ operating point; all nine fail, as does the screened-only TimesFM/Electricity cell, which has no paired run and so no selection-split gate: it scores $+0.132$ on the held-out windows), CKA after full fine-tuning, and the two outcome readings as \% change against zero-shot (\emph  {negative is better than zero-shot}). \textbf  {Protocol note:} this arm is univariate OT, lookback 96, $h{=}24$, 200 held-out windows, per-window $z$-scored; the Moirai arm of \S  \ref {sec:forecasting} is lookback 192, $h{=}96$, 300 windows, train-normalised. Gates for both arms come from one source (\texttt  {results/gate\_val\_side.json}, via \texttt  {scripts/cell\_matrix.py}); the two arms are never pooled.}}{22}{table.caption.18}\protected@file@percent }
\newlabel{tab:crossbackbone}{{9}{22}{\textbf {Cross-backbone results ($h{=}24$)} (\S \ref {sec:forecasting:nonmoirai}). Every non-Moirai cell with a paired frozen-encoder run: \textbf {selection-split} gate $\Vb {\text {ridge}}$ (\textsuperscript {f}${=}$gate-fail at the $0.20$ operating point; all nine fail, as does the screened-only TimesFM/Electricity cell, which has no paired run and so no selection-split gate: it scores $+0.132$ on the held-out windows), CKA after full fine-tuning, and the two outcome readings as \% change against zero-shot (\emph {negative is better than zero-shot}). \textbf {Protocol note:} this arm is univariate OT, lookback 96, $h{=}24$, 200 held-out windows, per-window $z$-scored; the Moirai arm of \S \ref {sec:forecasting} is lookback 192, $h{=}96$, 300 windows, train-normalised. Gates for both arms come from one source (\texttt {results/gate\_val\_side.json}, via \texttt {scripts/cell\_matrix.py}); the two arms are never pooled}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {Mitigation spectrum on Moirai-Small/ETTh2.} Rows ordered by representation preservation (CKA at $h{=}96$). On \emph  {this} cell LoRA preserves representations (CKA${\approx }0.98$) while \emph  {improving} on zero-shot, and weight anchoring reduces drift without buying utility. \textbf  {Neither reading generalises, and we checked rather than assumed:} extending condition~E to 8 further value-cells (Appendix~\ref {app:loravaluecells}) puts CKA$_\text  {E}$ anywhere from $0.55$ to $0.97$ and leaves full fine-tuning ahead of LoRA on 4 of the 8. \textbf  {Every row is scored against its own zero-shot.} Forgetting\% is the mean over seeds of each run's $(\text  {fine-tuned}-\text  {zero-shot})/ \text  {zero-shot}$, so no row borrows another's denominator. MSE, CKA and $\ell _2$ drift are means over seeds with population std (ddof${=}0$); the body's SEM convention (\S  \ref {sec:method}) does not apply here. \textbf  {The rows are not matched on training-set size.} Conditions B, C and D use $n{=}500$ training samples (zero-shot MSE $.1256$ at $h{=}96$, $.1580$ at $h{=}192$); E, F and G use $n{=}1{,}000$ (zero-shot MSE $.1274$ and $.1596$); the two rightmost columns give the seed count and the training-set size separately. We therefore claim no ordering \emph  {between} the two groups: there is no full-fine-tuning arm at $n{=}1{,}000$ on this cell with more than a single seed, so ``anchoring ties full fine-tuning'' is not a comparison these runs support. The dissociation the table is cited for (CKA not predicting utility) is within-group and unaffected. Condition~D reads CKA $0.99996$ rather than $1$: it leaves \texttt  {in\_proj} and \texttt  {mask\_encoding} trainable, so it is a frozen-\emph  {encoder} control and not a strict freeze. Only condition~H (Appendix~\ref {app:strictfreeze}) is $1.0000$ by construction.}}{23}{table.caption.20}\protected@file@percent }
\newlabel{tab:mitigation_spectrum}{{10}{23}{\textbf {Mitigation spectrum on Moirai-Small/ETTh2.} Rows ordered by representation preservation (CKA at $h{=}96$). On \emph {this} cell LoRA preserves representations (CKA${\approx }0.98$) while \emph {improving} on zero-shot, and weight anchoring reduces drift without buying utility. \textbf {Neither reading generalises, and we checked rather than assumed:} extending condition~E to 8 further value-cells (Appendix~\ref {app:loravaluecells}) puts CKA$_\text {E}$ anywhere from $0.55$ to $0.97$ and leaves full fine-tuning ahead of LoRA on 4 of the 8. \textbf {Every row is scored against its own zero-shot.} Forgetting\% is the mean over seeds of each run's $(\text {fine-tuned}-\text {zero-shot})/ \text {zero-shot}$, so no row borrows another's denominator. MSE, CKA and $\ell _2$ drift are means over seeds with population std (ddof${=}0$); the body's SEM convention (\S \ref {sec:method}) does not apply here. \textbf {The rows are not matched on training-set size.} Conditions B, C and D use $n{=}500$ training samples (zero-shot MSE $.1256$ at $h{=}96$, $.1580$ at $h{=}192$); E, F and G use $n{=}1{,}000$ (zero-shot MSE $.1274$ and $.1596$); the two rightmost columns give the seed count and the training-set size separately. We therefore claim no ordering \emph {between} the two groups: there is no full-fine-tuning arm at $n{=}1{,}000$ on this cell with more than a single seed, so ``anchoring ties full fine-tuning'' is not a comparison these runs support. The dissociation the table is cited for (CKA not predicting utility) is within-group and unaffected. Condition~D reads CKA $0.99996$ rather than $1$: it leaves \texttt {in\_proj} and \texttt {mask\_encoding} trainable, so it is a frozen-\emph {encoder} control and not a strict freeze. Only condition~H (Appendix~\ref {app:strictfreeze}) is $1.0000$ by construction}{table.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Where the freeze boundary falls, module by module.} Green boxes are parameters the optimiser may move; hatched boxes are held at their pre-trained values. The grid is transcribed from the \texttt  {requires\_grad} assignments in \texttt  {scripts/finetune\_forecasting.py}. Two of our seven survivors change the sign of $\Delta _\text  {enc}$ between~D and~H (Table~\ref {tab:strictfreeze}), so which of these columns a paper means by ``we froze the encoder'' is not a detail.}}{23}{figure.caption.22}\protected@file@percent }
\newlabel{fig:freezeboundary}{{4}{23}{\textbf {Where the freeze boundary falls, module by module.} Green boxes are parameters the optimiser may move; hatched boxes are held at their pre-trained values. The grid is transcribed from the \texttt {requires\_grad} assignments in \texttt {scripts/finetune\_forecasting.py}. Two of our seven survivors change the sign of $\denc $ between~D and~H (Table~\ref {tab:strictfreeze}), so which of these columns a paper means by ``we froze the encoder'' is not a detail}{figure.caption.22}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces The strict-freeze control (condition~H) beside condition~D on sixteen cells: the six that met the degradation definition under the unfitted trend baseline, plus ILI, plus the five gate-passing survivors of \S  \ref {sec:forecasting:results}, plus all four Moirai/ETTm2 value-cells. \textbf  {B$-$H keeps B$-$D's sign on twelve and reverses it on all four ETTm2 cells}, where condition~D's margin was the input projection re-fitting rather than the encoder being held still. B$-$D is restricted to the seeds condition~H ran, and a cell with fewer than three H seeds is excluded and named by the emitter rather than printed thin. $n$ is shown on every row and is not constant down the column; ILI's $452$ is its whole training split rather than a cap (Table~\ref {tab:heldout_all}). Generated by \texttt  {scripts/cell\_matrix.py --latex}.}}{24}{table.caption.23}\protected@file@percent }
\newlabel{tab:strictfreeze}{{11}{24}{The strict-freeze control (condition~H) beside condition~D on sixteen cells: the six that met the degradation definition under the unfitted trend baseline, plus ILI, plus the five gate-passing survivors of \S \ref {sec:forecasting:results}, plus all four Moirai/ETTm2 value-cells. \textbf {B$-$H keeps B$-$D's sign on twelve and reverses it on all four ETTm2 cells}, where condition~D's margin was the input projection re-fitting rather than the encoder being held still. B$-$D is restricted to the seeds condition~H ran, and a cell with fewer than three H seeds is excluded and named by the emitter rather than printed thin. $n$ is shown on every row and is not constant down the column; ILI's $452$ is its whole training split rather than a cap (Table~\ref {tab:heldout_all}). Generated by \texttt {scripts/cell\_matrix.py --latex}}{table.caption.23}{}}
