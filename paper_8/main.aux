\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces \textbf  {Paired seed-level inference on encoder adaptation.} $\Delta _\text  {enc}={L_\text  {full}}-{L_\text  {frozen}}$ per seed, in percent of the cell's zero-shot reference, so a positive value means allowing the encoder to adapt made the cell \emph  {worse}. B and D share a seed, an initialisation and a window sample, so this contrast is paired by construction. $d$ is paired Cohen's $d$. The SEM column was dropped when $q$ was added (nine columns overrun the textwidth and the interval states the same dispersion), so \texttt  {sem} lives in \texttt  {results/paired\_inference.json}, on the body's convention (\S  \ref {sec:method}). Each row names its own $n$, which is not constant down the column (Table~\ref {tab:heldout_all}). \textbf  {$q$ is the decision column, adjusted for the 31 tests}: Benjamini--Hochberg within this contrast, with the three-way call (freeze-decisive, adapt-decisive, inconclusive) read off $q{<}0.05$ and the sign of $\Delta _\text  {enc}$, and bolded where decisive. BH runs on $p_t$, not $p_\text  {exact}$, because 24 cells have an exact floor of $0.25$ and a step-up procedure there would reject nothing at any effect size. \textbf  {Two tests, because neither alone is adequate at these seed counts.} $p_\text  {exact}$ assumes nothing, but its resolution is fixed by $N$: the 24 cells at $N{=}3$ cannot reach $p<0.05$ at any effect size, their smallest attainable value being $0.25$. $p_t$ and the interval do resolve there, and pay for it with a normality assumption on three points that cannot be checked. Both are shown so that a reading resting on that assumption is visible as one; the text states why no bootstrap interval is reported. In the two summary rows the last column is \emph  {not} an effect size: it gives the number of cells whose mean $\Delta _\text  {enc}$ is positive, out of the cells in that row. $\dagger $ marks cells clearing the gate threshold under at least one admissible baseline of the ladder (Appendix~\ref {app:baselines}). $\ddagger $ marks the Chronos cells, whose per-condition forgetting is confounded by the head/decoder mismatch; their $\Delta _\text  {enc}$ is unaffected.}}{41}{table.caption.32}\protected@file@percent }
\newlabel{tab:paired_inference}{{20}{41}{\textbf {Paired seed-level inference on encoder adaptation.} $\Delta _\text {enc}={L_\text {full}}-{L_\text {frozen}}$ per seed, in percent of the cell's zero-shot reference, so a positive value means allowing the encoder to adapt made the cell \emph {worse}. B and D share a seed, an initialisation and a window sample, so this contrast is paired by construction. $d$ is paired Cohen's $d$. The SEM column was dropped when $q$ was added (nine columns overrun the textwidth and the interval states the same dispersion), so \texttt {sem} lives in \texttt {results/paired\_inference.json}, on the body's convention (\S \ref {sec:method}). Each row names its own $n$, which is not constant down the column (Table~\ref {tab:heldout_all}). \textbf {$q$ is the decision column, adjusted for the 31 tests}: Benjamini--Hochberg within this contrast, with the three-way call (freeze-decisive, adapt-decisive, inconclusive) read off $q{<}0.05$ and the sign of $\denc $, and bolded where decisive. BH runs on $p_t$, not $p_\text {exact}$, because 24 cells have an exact floor of $0.25$ and a step-up procedure there would reject nothing at any effect size. \textbf {Two tests, because neither alone is adequate at these seed counts.} $p_\text {exact}$ assumes nothing, but its resolution is fixed by $N$: the 24 cells at $N{=}3$ cannot reach $p<0.05$ at any effect size, their smallest attainable value being $0.25$. $p_t$ and the interval do resolve there, and pay for it with a normality assumption on three points that cannot be checked. Both are shown so that a reading resting on that assumption is visible as one; the text states why no bootstrap interval is reported. In the two summary rows the last column is \emph {not} an effect size: it gives the number of cells whose mean $\Delta _\text {enc}$ is positive, out of the cells in that row. $\dagger $ marks cells clearing the gate threshold under at least one admissible baseline of the ladder (Appendix~\ref {app:baselines}). $\ddagger $ marks the Chronos cells, whose per-condition forgetting is confounded by the head/decoder mismatch; their $\Delta _\text {enc}$ is unaffected}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces \textbf  {What each surviving cell's own seed budget could detect.} The 7 cells clearing $V_{\text  {ridge}}{\geq }0.20$, with the minimum detectable effect implied by their own dispersion: MDE $= t_{1-\alpha /2,n-1}\,\text  {sd}/\sqrt  {n}$, the smallest $|\Delta _\text  {enc}|$ a two-sided paired $t$ would resolve at that $n$. $n^\star $ is the paired seed count at which the \emph  {observed} effect would resolve, holding the observed sd fixed; it is therefore a post-hoc estimate and not a design calculation. \textbf  {Two columns, because a single test and a decisive call cost different budgets.} $n^\star $ is computed at an uncorrected $\alpha {=}0.05$; $n^\star _\text  {adj}$ is computed at $\alpha /m$ with $m{=}31$ tests, which bounds the Benjamini--Hochberg threshold the call in Table~\ref {tab:paired_inference} actually uses from below and so bounds the budget from above. Reporting only $n^\star $ would say Moirai-Base/ETTh2 $h{=}192$ is already resolved at $n{=}3$, which its own $q{=}0.018$ happens to agree with, and would say the same of $h{=}96$, whose $q$ is $0.071$. \textbf  {The 4 starred rows are the point of the table}: they need more than our feasibility cap of 20 paired seeds ($\approx $20 GPU-hours per cell at two fine-tunes per seed), so we report them as \emph  {unresolvable under this design}, with the number, rather than as effects that are absent.}}{42}{table.caption.33}\protected@file@percent }
\newlabel{tab:power_mde}{{21}{42}{\textbf {What each surviving cell's own seed budget could detect.} The 7 cells clearing $\Vb {\text {ridge}}{\geq }0.20$, with the minimum detectable effect implied by their own dispersion: MDE $= t_{1-\alpha /2,n-1}\,\text {sd}/\sqrt {n}$, the smallest $|\denc |$ a two-sided paired $t$ would resolve at that $n$. $n^\star $ is the paired seed count at which the \emph {observed} effect would resolve, holding the observed sd fixed; it is therefore a post-hoc estimate and not a design calculation. \textbf {Two columns, because a single test and a decisive call cost different budgets.} $n^\star $ is computed at an uncorrected $\alpha {=}0.05$; $n^\star _\text {adj}$ is computed at $\alpha /m$ with $m{=}31$ tests, which bounds the Benjamini--Hochberg threshold the call in Table~\ref {tab:paired_inference} actually uses from below and so bounds the budget from above. Reporting only $n^\star $ would say Moirai-Base/ETTh2 $h{=}192$ is already resolved at $n{=}3$, which its own $q{=}0.018$ happens to agree with, and would say the same of $h{=}96$, whose $q$ is $0.071$. \textbf {The 4 starred rows are the point of the table}: they need more than our feasibility cap of 20 paired seeds ($\approx $20 GPU-hours per cell at two fine-tunes per seed), so we report them as \emph {unresolvable under this design}, with the number, rather than as effects that are absent}{table.caption.33}{}}
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text  {backbone}, \text  {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt  {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster.}}{42}{table.caption.34}\protected@file@percent }
\newlabel{tab:crosscell}{{22}{42}{Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text {backbone}, \text {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster}{table.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces \textbf  {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\Delta _\text  {enc}$ is the manipulated contrast between them. Gate values marked~\textsuperscript  {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt  {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding.}}{42}{table.caption.35}\protected@file@percent }
\newlabel{tab:dissociation}{{23}{42}{\textbf {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\denc $ is the manipulated contrast between them. Gate values marked~\textsuperscript {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding}{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces Within-backbone slope of held-out B$-$D on CKA, in percentage points per unit of CKA, with backbone identity absorbed as a fixed effect rather than by subsetting. Intervals are $10{,}000$ cluster-bootstrap draws over the 15 $(\text  {backbone}, \text  {dataset})$ clusters of 31 cells; draws in which the fixed effects are unidentified or the design is rank-deficient are discarded, and the kept count is reported. Emitted by \texttt  {scripts/clustered\_inference.py} from \texttt  {scripts/cka\_fixed\_effects.py}.}}{43}{table.caption.36}\protected@file@percent }
\newlabel{tab:clustered_fe}{{24}{43}{Within-backbone slope of held-out B$-$D on CKA, in percentage points per unit of CKA, with backbone identity absorbed as a fixed effect rather than by subsetting. Intervals are $10{,}000$ cluster-bootstrap draws over the 15 $(\text {backbone}, \text {dataset})$ clusters of 31 cells; draws in which the fixed effects are unidentified or the design is rank-deficient are discarded, and the kept count is reported. Emitted by \texttt {scripts/clustered\_inference.py} from \texttt {scripts/cka\_fixed\_effects.py}}{table.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces \textbf  {Does CKA add out-of-sample predictive information about $\Delta _\text  {enc}$ beyond backbone identity?} Nested models over all 31 scored cells, validated by leave-one-cluster-out across the 15 (backbone, dataset) clusters. $R^2_\text  {LOCO}$ is scored \textbf  {against the training-fold mean}, never the held-out fold's own mean, so a positive value means the model beats predicting the other clusters' average; MAE is in percentage points of zero-shot loss. \textbf  {The deciding statistic and this table's interpretation were fixed before the models were fitted} (\texttt  {results/preregister\_loco.json}): $\Delta R^2 = R^2_\text  {LOCO}(\text  {M3}) - R^2_\text  {LOCO}(\text  {M2}) = -0.025$, median bootstrap draw $-0.083$, IQR $[-0.227, +0.043]$, and adding CKA fails to help in 69\% of draws; $\Delta \text  {MAE} = +0.59$~pp, IQR $[-0.37, +2.98]$. \textbf  {Interquartile ranges, not 95\% intervals, are quoted for both}: an out-of-sample $R^2$ is unbounded below and a degenerate bootstrap fold can blow up either statistic, so their extreme percentiles are not reproducible: $\Delta R^2$'s 2.5th percentile moved between $-1.7$ and $-32.5$ across bootstrap seeds, and $\Delta $MAE's 97.5th between $+11$ and $+19$, while the point estimates, medians and sign share moved in the third decimal. \textbf  {The 95\% interval is carried instead by the one linear coefficient here}, CKA's slope in M3: $+43$~pp per unit CKA, cluster-bootstrap CI $[-31, +107]$, which covers zero, so the slope's sign is not even determined, let alone its size. That interval is quoted to whole percentage points because its bounds move by under 5~pp across bootstrap seeds. The pre-registered deciding statistic (the \emph  {sign} of $\Delta R^2$) is unchanged; only the dispersion measure beside it differs from the registration, which says so. Dataset identity is deliberately \emph  {absent} from the ladder: a cluster is a (backbone, dataset) pair, so holding one out removes the only cells that identify that dataset's fixed effect and the fold would silently score a model nobody specified: three of the 7 series are covered by a single backbone, so no other fold could identify them even in principle. The in-sample fit \emph  {with} dataset fixed effects is reported in the text and is not validation.}}{43}{table.caption.37}\protected@file@percent }
\newlabel{tab:cka_loco}{{25}{43}{\textbf {Does CKA add out-of-sample predictive information about $\denc $ beyond backbone identity?} Nested models over all 31 scored cells, validated by leave-one-cluster-out across the 15 (backbone, dataset) clusters. $R^2_\text {LOCO}$ is scored \textbf {against the training-fold mean}, never the held-out fold's own mean, so a positive value means the model beats predicting the other clusters' average; MAE is in percentage points of zero-shot loss. \textbf {The deciding statistic and this table's interpretation were fixed before the models were fitted} (\texttt {results/preregister\_loco.json}): $\Delta R^2 = R^2_\text {LOCO}(\text {M3}) - R^2_\text {LOCO}(\text {M2}) = -0.025$, median bootstrap draw $-0.083$, IQR $[-0.227, +0.043]$, and adding CKA fails to help in 69\% of draws; $\Delta \text {MAE} = +0.59$~pp, IQR $[-0.37, +2.98]$. \textbf {Interquartile ranges, not 95\% intervals, are quoted for both}: an out-of-sample $R^2$ is unbounded below and a degenerate bootstrap fold can blow up either statistic, so their extreme percentiles are not reproducible: $\Delta R^2$'s 2.5th percentile moved between $-1.7$ and $-32.5$ across bootstrap seeds, and $\Delta $MAE's 97.5th between $+11$ and $+19$, while the point estimates, medians and sign share moved in the third decimal. \textbf {The 95\% interval is carried instead by the one linear coefficient here}, CKA's slope in M3: $+43$~pp per unit CKA, cluster-bootstrap CI $[-31, +107]$, which covers zero, so the slope's sign is not even determined, let alone its size. That interval is quoted to whole percentage points because its bounds move by under 5~pp across bootstrap seeds. The pre-registered deciding statistic (the \emph {sign} of $\Delta R^2$) is unchanged; only the dispersion measure beside it differs from the registration, which says so. Dataset identity is deliberately \emph {absent} from the ladder: a cluster is a (backbone, dataset) pair, so holding one out removes the only cells that identify that dataset's fixed effect and the fold would silently score a model nobody specified: three of the 7 series are covered by a single backbone, so no other fold could identify them even in principle. The in-sample fit \emph {with} dataset fixed effects is reported in the text and is not validation}{table.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces \textbf  {The pre-registered positive control: 21 runs, no destruction.} Task A is Moirai-Small/ETTh2 $h{=}192$; task B is the anti-persistent synthetic series, fixed by SHA-256 before any run. ``task B learned'' is the MSE reduction on B's own held-out windows (registered validity threshold $20\%$). ``retention on task A'' is $100(\text  {MSE}_A(\theta _\text  {FT}) - \text  {MSE}_A(\theta _\text  {ZS}))/\text  {MSE}_A(\theta _\text  {ZS})$, so \emph  {positive is worse} and the registered destruction threshold is $+50\%$ in a majority of seeds under full fine-tuning. CKA is measured on \textbf  {task A's} inputs. $\pm $ is the SEM over 3 seeds. $^{\dagger }$ marks the single declared ladder extension. Read every retention number against the $0.48$~pp evaluator noise floor derived in the text.}}{44}{table.caption.38}\protected@file@percent }
\newlabel{tab:poscontrol}{{26}{44}{\textbf {The pre-registered positive control: 21 runs, no destruction.} Task A is Moirai-Small/ETTh2 $h{=}192$; task B is the anti-persistent synthetic series, fixed by SHA-256 before any run. ``task B learned'' is the MSE reduction on B's own held-out windows (registered validity threshold $20\%$). ``retention on task A'' is $100(\text {MSE}_A(\theta _\text {FT}) - \text {MSE}_A(\theta _\text {ZS}))/\text {MSE}_A(\theta _\text {ZS})$, so \emph {positive is worse} and the registered destruction threshold is $+50\%$ in a majority of seeds under full fine-tuning. CKA is measured on \textbf {task A's} inputs. $\pm $ is the SEM over 3 seeds. $^{\dagger }$ marks the single declared ladder extension. Read every retention number against the $0.48$~pp evaluator noise floor derived in the text}{table.caption.38}{}}
\gdef \@abspage@last{44}
