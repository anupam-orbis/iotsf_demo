\@writefile{lot}{\contentsline {table}{\numberline {35}{\ignorespaces Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text  {backbone}, \text  {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt  {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster.}}{59}{table.caption.49}\protected@file@percent }
\newlabel{tab:crosscell}{{35}{59}{Is the pooled CKA correlation a backbone artefact? The same statistic (Spearman $\rho $ of CKA against held-out B$-$D, $10{,}000$-resample bootstrap CI) computed pooled and then stratified by backbone, at both resampling levels. ``Cl.'' is the number of $(\text {backbone}, \text {dataset})$ clusters, which is the effective sample size for the clustered interval and is far below $n$. Values are emitted by \texttt {scripts/clustered\_inference.py}. The pooled row is reported for audit, not read as evidence; the two small arms carry essentially no information at their cell counts, and for them the two levels coincide because every cell is already its own cluster}{table.caption.49}{}}
\@writefile{lot}{\contentsline {table}{\numberline {36}{\ignorespaces \textbf  {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\Delta _\text  {enc}$ is the manipulated contrast between them. Gate values marked~\textsuperscript  {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt  {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding; these four CKA values and four percentages were previously quoted in body prose alone.}}{60}{table.caption.50}\protected@file@percent }
\newlabel{tab:dissociation}{{36}{60}{\textbf {The within-backbone dissociation, one capacity, eight cells.} Every Moirai-Base cell, ordered by CKA (most drifted first). ``Full FT'' and ``Frozen'' are percent change in held-out MSE against zero-shot, so negative is better and positive is task-level forgetting; $\denc $ is the manipulated contrast between them. Gate values marked~\textsuperscript {f} fail the $0.20$ screen. Reading down the CKA column, the outcome reverses sign: the two least drifted cells are the only two that degrade. Emitted by \texttt {scripts/emit\_dissociation.py}, which asserts both of those claims against the run records and exits non-zero if they stop holding; these four CKA values and four percentages were previously quoted in body prose alone}{table.caption.50}{}}
\@writefile{toc}{\contentsline {section}{\numberline {A27}Is the Reading Specific to CKA? Six Measures on 59 Encoders}{60}{appendix.Alph27}\protected@file@percent }
