\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\Delta _\text  {enc}$ (positive ${=}$ freezing better). Filled markers clear $V_{\text  {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph  {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel.}}{63}{figure.caption.52}\protected@file@percent }
\newlabel{fig:gatescatter}{{7}{63}{\textbf {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\denc $ (positive ${=}$ freezing better). Filled markers clear $\Vb {\text {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel}{figure.caption.52}{}}
