\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Batch 3 of the pre-registered prospective test: the fitted gate, graded on cells whose outcomes did not exist when it was frozen.} gate$_\text  {val}$ is the corrected selection-split ridge gate of \S  \ref {sec:forecasting}, frozen in the registration; ``pred.'' is the registered gate rule at the $0.20$ operating point. $\Delta _\text  {FT}$ and $\Delta _\text  {frozen}$ are B$-$ZS and D$-$ZS in percent of zero-shot loss, with $95\%$ intervals propagating the zero-shot reference's own error; ``Degr.?'' applies the registered interval rule. The $\Delta _\text  {enc}$ call is BH-adjusted within this batch only. A tenth registered cell (Moirai-Large/ETTm2 $h{=}96$, gate $-0.278$) was deferred for the submission deadline and is disclosed in Appendix~\ref {app:prospective3}.}}{4}{table.caption.3}\protected@file@percent }
\newlabel{tab:prospective3}{{S3}{4}{\textbf {Batch 3 of the pre-registered prospective test: the fitted gate, graded on cells whose outcomes did not exist when it was frozen.} gate$_\text {val}$ is the corrected selection-split ridge gate of \S \ref {sec:forecasting}, frozen in the registration; ``pred.'' is the registered gate rule at the $0.20$ operating point. $\Delta _\text {FT}$ and $\Delta _\text {frozen}$ are B$-$ZS and D$-$ZS in percent of zero-shot loss, with $95\%$ intervals propagating the zero-shot reference's own error; ``Degr.?'' applies the registered interval rule. The $\denc $ call is BH-adjusted within this batch only. A tenth registered cell (Moirai-Large/ETTm2 $h{=}96$, gate $-0.278$) was deferred for the submission deadline and is disclosed in Appendix~\ref {app:prospective3}}{table.caption.3}{}}
