\newlabel{app:defsensitivity}{{S8}{11}{Is the Zero a Property of the Runs or of the Definition?}{section.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S12}{\ignorespaces Degradation cells admitted under eight definitions and two gate thresholds. Cells are named, not just counted. Under the fitted gate no cell is admitted at $0.10$ alone, so the two columns agree throughout. The excluded confounded cells are Chronos-T5-Small on ETTh1, ETTh2, ETTm2, Weather and Electricity. Emitted by \texttt  {scripts/degradation\_sensitivity.py}.}}{12}{table.caption.12}\protected@file@percent }
\newlabel{tab:defsensitivity}{{S12}{12}{Degradation cells admitted under eight definitions and two gate thresholds. Cells are named, not just counted. Under the fitted gate no cell is admitted at $0.10$ alone, so the two columns agree throughout. The excluded confounded cells are Chronos-T5-Small on ETTh1, ETTh2, ETTm2, Weather and Electricity. Emitted by \texttt {scripts/degradation\_sensitivity.py}}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S13}{\ignorespaces \textbf  {The pre-registered seed top-up, beside the published seed counts.} The 7 cells clearing $V_{\text  {ridge}}{\geq }0.20$. 3 were topped up under \texttt  {results/power\_topup/preregistration\_power.json}, which fixed which cells, which seeds and how many (26 runs) before any of those runs existed; all 26 completed. \textbf  {No published number is replaced.} Each cell's \emph  {published} row is the analysis of Table~\ref {tab:paired_inference}, re-verified against \texttt  {results/paired\_inference.json} at emit time; its \emph  {augmented} row is a second computation with the added seeds admitted, on the same estimator and the same Benjamini--Hochberg correction over the same 31 cells. \textbf  {One call changes}: Moirai-S / ETTm2 ($h{=}192$, $n{=}$1000) moves from inconclusive to freezing-decisive, first at $n{=}12$, with the rung below it at $q{=}0.059$. Across all 31 cells the augmented read changes that call and no other (published 2 freezing-better, 4 adaptation-better, 25 inconclusive; augmented 3, 4, 24). The 2 cells on the \emph  {uncorrected} tier were run to a budget below their BH-adjusted requirement and were registered as \emph  {expected to remain inconclusive}, which held for 1 of the 2 (Moirai-S / ETTh2 ($h{=}192$, $n{=}$500)) and failed for Moirai-S / ETTm2 ($h{=}192$, $n{=}$1000). A failed registered prediction is reported as one; the registration is not edited. The ladder behind ``first at'' admits each cell's added seeds in registered order with the other topped-up cells at their final $n$, so a change is attributable to that cell's own seeds and not to BH moving underneath it. The last column gives each cell's registered budget and the tier it came from (adj.\ = the BH-adjusted requirement, unc.\ = the uncorrected one), or the reason it was not topped up.}}{13}{table.caption.13}\protected@file@percent }
\newlabel{tab:power_topup}{{S13}{13}{\textbf {The pre-registered seed top-up, beside the published seed counts.} The 7 cells clearing $\Vb {\text {ridge}}{\geq }0.20$. 3 were topped up under \texttt {results/power\_topup/preregistration\_power.json}, which fixed which cells, which seeds and how many (26 runs) before any of those runs existed; all 26 completed. \textbf {No published number is replaced.} Each cell's \emph {published} row is the analysis of Table~\ref {tab:paired_inference}, re-verified against \texttt {results/paired\_inference.json} at emit time; its \emph {augmented} row is a second computation with the added seeds admitted, on the same estimator and the same Benjamini--Hochberg correction over the same 31 cells. \textbf {One call changes}: Moirai-S / ETTm2 ($h{=}192$, $n{=}$1000) moves from inconclusive to freezing-decisive, first at $n{=}12$, with the rung below it at $q{=}0.059$. Across all 31 cells the augmented read changes that call and no other (published 2 freezing-better, 4 adaptation-better, 25 inconclusive; augmented 3, 4, 24). The 2 cells on the \emph {uncorrected} tier were run to a budget below their BH-adjusted requirement and were registered as \emph {expected to remain inconclusive}, which held for 1 of the 2 (Moirai-S / ETTh2 ($h{=}192$, $n{=}$500)) and failed for Moirai-S / ETTm2 ($h{=}192$, $n{=}$1000). A failed registered prediction is reported as one; the registration is not edited. The ladder behind ``first at'' admits each cell's added seeds in registered order with the other topped-up cells at their final $n$, so a change is attributable to that cell's own seeds and not to BH moving underneath it. The last column gives each cell's registered budget and the tier it came from (adj.\ = the BH-adjusted requirement, unc.\ = the uncorrected one), or the reason it was not topped up}{table.caption.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S9}A Pre-Registered Seed Top-Up}{13}{section.9}\protected@file@percent }
\newlabel{app:powertopup}{{S9}{13}{A Pre-Registered Seed Top-Up}{section.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S10}The Graded Value Axis: Is the Dissociation Confined to Cells With Nothing to Lose?}{15}{section.10}\protected@file@percent }
\newlabel{app:valueaxis}{{S10}{15}{The Graded Value Axis: Is the Dissociation Confined to Cells With Nothing to Lose?}{section.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Neither drift nor measured pre-trained value orders the encoder intervention.} Both panels share $y{=}$ held-out $\Delta _\text  {enc}$ (positive $=$ freezing the encoder did better). Point area is proportional to the graded value score in \emph  {both} panels, so the left panel answers the objection visually: if drift predicted the outcome wherever there was something to lose, the large points would trend and the small ones would scatter. Backbone is encoded by colour \emph  {and} marker because CKA is not comparable across architectures, which is why the pooled left-panel interval must not be read as a within-backbone one. Drawn by \texttt  {paper\_8/fig\_value\_axis.py} from \texttt  {results/value\_axis.json}; the script asserts its own counts against that file and fails rather than drawing a figure that disagrees with this text.}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:valueaxis}{{S1}{15}{\textbf {Neither drift nor measured pre-trained value orders the encoder intervention.} Both panels share $y{=}$ held-out $\denc $ (positive $=$ freezing the encoder did better). Point area is proportional to the graded value score in \emph {both} panels, so the left panel answers the objection visually: if drift predicted the outcome wherever there was something to lose, the large points would trend and the small ones would scatter. Backbone is encoded by colour \emph {and} marker because CKA is not comparable across architectures, which is why the pooled left-panel interval must not be read as a within-backbone one. Drawn by \texttt {paper\_8/fig\_value\_axis.py} from \texttt {results/value\_axis.json}; the script asserts its own counts against that file and fails rather than drawing a figure that disagrees with this text}{figure.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S14}{\ignorespaces \textbf  {The dependence, estimated two ways.} Rank rows are Spearman $\rho $ with $10{,}000$ bootstrap draws over $(\text  {backbone}, \text  {dataset})$ clusters, seed~$0$. The slope rows fit all cells at once with backbone identity absorbed as a fixed effect and both regressors centred, so $b_1$ is the CKA slope \emph  {at mean value}; $b_3$ is the quantity at issue. Emitted by \texttt  {scripts/value\_axis.py --latex}, which delegates the slope fit to \texttt  {scripts/cka\_fixed\_effects.py} rather than refitting it.}}{16}{table.caption.15}\protected@file@percent }
\newlabel{tab:valueaxis}{{S14}{16}{\textbf {The dependence, estimated two ways.} Rank rows are Spearman $\rho $ with $10{,}000$ bootstrap draws over $(\text {backbone}, \text {dataset})$ clusters, seed~$0$. The slope rows fit all cells at once with backbone identity absorbed as a fixed effect and both regressors centred, so $b_1$ is the CKA slope \emph {at mean value}; $b_3$ is the quantity at issue. Emitted by \texttt {scripts/value\_axis.py --latex}, which delegates the slope fit to \texttt {scripts/cka\_fixed\_effects.py} rather than refitting it}{table.caption.15}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S11}Is the Reading Specific to CKA? Six Measures on 59 Encoders}{16}{section.11}\protected@file@percent }
\newlabel{app:driftmetrics}{{S11}{16}{Is the Reading Specific to CKA? Six Measures on 59 Encoders}{section.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S15}{\ignorespaces \textbf  {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph  {selection-split} figure: these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S  \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt  {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling.}}{17}{table.caption.16}\protected@file@percent }
\newlabel{tab:driftmetrics}{{S15}{17}{\textbf {Six measures of representation change on 59 Moirai-Small encoders.} All computed on identical windows and identical pooling. ``$\rho $ with CKA'' is the rank correlation of each measure with linear CKA over the 59 encoders; the last two columns correlate each measure with forgetting, pooled and then within each of the six groups of at least five encoders. Forgetting here is the \emph {selection-split} figure: these runs stored no zero-shot test MSE, so a held-out contrast cannot be reconstructed from them, and \S \ref {sec:analysis:heldout} shows same-split scoring can invert the sign of the intervention. This arm is therefore a comparison of measures, not a held-out claim. Emitted by \texttt {scripts/drift\_metric\_battery.py}; the pooled column mixes three datasets and is descriptive for the reason Appendix~\ref {app:crosscell} gives about pooling}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\Delta _\text  {enc}$ (positive ${=}$ freezing better). Filled markers clear $V_{\text  {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph  {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel.}}{18}{figure.caption.17}\protected@file@percent }
\newlabel{fig:gatescatter}{{S2}{18}{\textbf {The screen's own axis.} All 31 intervention cells as the selection-split gate against held-out $\denc $ (positive ${=}$ freezing better). Filled markers clear $\Vb {\text {ridge}}{\geq }0.20$; the shaded strip is the only region a cell could occupy and still satisfy clause~(i) of the degradation definition, and most of the cells in it lie \emph {below} zero, where letting the encoder adapt helped. The two axes are scored on disjoint window sets, so a cell's horizontal position is not a re-description of its vertical one. ILI is named on the frame rather than plotted: its gate is $-10.21$, and an axis wide enough to include it compresses the other 30 cells into a fifth of the panel}{figure.caption.17}{}}
