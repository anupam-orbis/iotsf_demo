\@writefile{lot}{\contentsline {table}{\numberline {S8}{\ignorespaces \textbf  {Gate $V_{b}$ under eight denominators and a floor, on one numerator, over the \emph  {held-out} windows.} The retrospective variant, retained because the prospective predictor of \S  \ref {sec:analysis:prospective} was frozen against it. Bold clears $0.20$. A dagger marks a denominator worse than the training-mean predictor on that cell: the ratio is still arithmetic, but it is not evidence of a pre-trained advantage, so daggered cells are excluded from the ``and admissible'' tally. The training-mean column is the floor, not a candidate estimator. The last row applies the three-clause degradation definition of \S  \ref {sec:method} with clause~(i) taken from each estimator and clauses~(ii) and~(iii) unchanged, over the 31 cells with a paired frozen-encoder run. Generated by \texttt  {scripts/gate\_baseline\_sensitivity.py}.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:baselinefamily}{{S8}{7}{\textbf {Gate $\Vb {b}$ under eight denominators and a floor, on one numerator, over the \emph {held-out} windows.} The retrospective variant, retained because the prospective predictor of \S \ref {sec:analysis:prospective} was frozen against it. Bold clears $0.20$. A dagger marks a denominator worse than the training-mean predictor on that cell: the ratio is still arithmetic, but it is not evidence of a pre-trained advantage, so daggered cells are excluded from the ``and admissible'' tally. The training-mean column is the floor, not a candidate estimator. The last row applies the three-clause degradation definition of \S \ref {sec:method} with clause~(i) taken from each estimator and clauses~(ii) and~(iii) unchanged, over the 31 cells with a paired frozen-encoder run. Generated by \texttt {scripts/gate\_baseline\_sensitivity.py}}{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {S7.2}A third window set: the ladder on the train tail}{8}{subsection.7.2}\protected@file@percent }
\newlabel{app:baselines:traintail}{{S7.2}{8}{A third window set: the ladder on the train tail}{subsection.7.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S9}{\ignorespaces \textbf  {The eight-rung ladder on three window sets.} Cells each rung admits: its denominator is at least as good as the training-mean floor on that cell \emph  {and} the cell's $V_{b}$ clears $0.20$. Every column is out of the same 21 Moirai cells (the ones the train-tail arm covers), so the counts are comparable across columns and are not the 31- and 32-cell counts quoted elsewhere. \emph  {Selection} is the paper's primary, \emph  {held-out} the retrospective variant, and \emph  {train tail} the last $20\%$ of the training region, used for neither checkpoint selection nor outcome scoring. The bottom row is the paper's conservative bound, and it is zero on all three.}}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:splitcompare}{{S9}{9}{\textbf {The eight-rung ladder on three window sets.} Cells each rung admits: its denominator is at least as good as the training-mean floor on that cell \emph {and} the cell's $\Vb {b}$ clears $0.20$. Every column is out of the same 21 Moirai cells (the ones the train-tail arm covers), so the counts are comparable across columns and are not the 31- and 32-cell counts quoted elsewhere. \emph {Selection} is the paper's primary, \emph {held-out} the retrospective variant, and \emph {train tail} the last $20\%$ of the training region, used for neither checkpoint selection nor outcome scoring. The bottom row is the paper's conservative bound, and it is zero on all three}{table.caption.9}{}}
