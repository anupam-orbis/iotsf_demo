\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces LoRA rank sensitivity on ETTh2 (condition E, 500 training samples). Moirai-Small: all ranks achieve near-identical MSE and CKA$\geq $0.979. Moirai-Large: all ranks forget $+$19 to $+$30\%, with no rank recovering Moirai-Small's negative forgetting. Mean $\pm $ std across 3 seeds (5 for $r{=}8$ Small); Moirai-Large single-seed ($s{=}42$) for $r \in \{16, 32, 64\}$ (std not reported; point estimates only), 3 seeds for $r{=}8$.}}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:lora_rank}{{S4}{4}{LoRA rank sensitivity on ETTh2 (condition E, 500 training samples). Moirai-Small: all ranks achieve near-identical MSE and CKA$\geq $0.979. Moirai-Large: all ranks forget $+$19 to $+$30\%, with no rank recovering Moirai-Small's negative forgetting. Mean $\pm $ std across 3 seeds (5 for $r{=}8$ Small); Moirai-Large single-seed ($s{=}42$) for $r \in \{16, 32, 64\}$ (std not reported; point estimates only), 3 seeds for $r{=}8$}{table.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S6}Chronos-T5-Small on M4-Monthly}{4}{section.6}\protected@file@percent }
\newlabel{app:chronos_detail}{{S6}{4}{Chronos-T5-Small on M4-Monthly}{section.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces LoRA-Large HP ablation (ETTh2, $r{=}8$, $n{=}500$, $h{=}96$). Baseline (default LR$=$1e-4, $\alpha {=}16$, modules $=$ q,v,out) forg.$=+23.7\%$, seed 42. Only LR$=$1e-5 rescues LoRA-Large (5~seeds); all other axes fail.}}{5}{table.caption.5}\protected@file@percent }
\newlabel{tab:lora_large_hp}{{S5}{5}{LoRA-Large HP ablation (ETTh2, $r{=}8$, $n{=}500$, $h{=}96$). Baseline (default LR$=$1e-4, $\alpha {=}16$, modules $=$ q,v,out) forg.$=+23.7\%$, seed 42. Only LR$=$1e-5 rescues LoRA-Large (5~seeds); all other axes fail}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces \textbf  {The value gate for Chronos/M4-Monthly.} Ten denominators against one numerator (median of $20$ Chronos samples, per-window $z$-scored), on both splits. A denominator worse than \texttt  {constant}, the training-mean predictor, cannot support a claim that the checkpoint has something worth preserving: it inflates $V_{b}$ in the direction that flatters the checkpoint, which is the effect that moves $17$ of $21$ Moirai cells between the unfitted and fitted screens (Appendix~\ref {app:gatecorrection}).}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:chronosm4gate}{{S6}{5}{\textbf {The value gate for Chronos/M4-Monthly.} Ten denominators against one numerator (median of $20$ Chronos samples, per-window $z$-scored), on both splits. A denominator worse than \texttt {constant}, the training-mean predictor, cannot support a claim that the checkpoint has something worth preserving: it inflates $\Vb {b}$ in the direction that flatters the checkpoint, which is the effect that moves $17$ of $21$ Moirai cells between the unfitted and fitted screens (Appendix~\ref {app:gatecorrection})}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces \textbf  {Conditions B and D on Chronos/M4-Monthly}, $n{=}500$ training windows, lr $10^{-5}$, batch $32$, $20$ epochs with patience $5$, early stopping on the selection windows and best epoch ${\geq }1$. Forgetting is \% change in held-out MSE against the same seed's zero-shot measurement (\emph  {negative is better than zero-shot}); $\Delta _\text  {enc}$ is the paired difference. CKA is the linear CKA of the mean-pooled final encoder output on the $200$ selection contexts, and the $\ell _2$ column is the encoder state dict's distance from pre-trained. Under condition D both are fixed \emph  {by construction} and not by measurement: on Chronos, freezing the encoder freezes the shared token embedding with it.}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:chronosm4runs}{{S7}{6}{\textbf {Conditions B and D on Chronos/M4-Monthly}, $n{=}500$ training windows, lr $10^{-5}$, batch $32$, $20$ epochs with patience $5$, early stopping on the selection windows and best epoch ${\geq }1$. Forgetting is \% change in held-out MSE against the same seed's zero-shot measurement (\emph {negative is better than zero-shot}); $\denc $ is the paired difference. CKA is the linear CKA of the mean-pooled final encoder output on the $200$ selection contexts, and the $\ell _2$ column is the encoder state dict's distance from pre-trained. Under condition D both are fixed \emph {by construction} and not by measurement: on Chronos, freezing the encoder freezes the shared token embedding with it}{table.caption.7}{}}
